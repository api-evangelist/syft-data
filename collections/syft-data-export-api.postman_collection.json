          "name": "Export the results of a motion's execution",
          "request": {
            "name": "Export the results of a motion's execution",
            "description": {
              "content": "Retrieve contacts and accounts processed by a motion, along with their evaluation outcomes and action summaries. Cursor-paginated; ideal for polling for motion results at a regular interval.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "motion",
                ":motionId",
                "export"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque pagination cursor; pass the nextCursor from the previous response."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50",
                  "description": "Max items per page (max 100)."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "Only return runs created/updated after this ISO8601 timestamp."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "Only return runs created/updated before this ISO8601 timestamp."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "completed",
                  "description": "Filter by status. Defaults to completed."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "asc"
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated top-level fields to include (runId always included)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "motionId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
