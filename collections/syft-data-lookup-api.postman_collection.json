  "info": {
    "_postman_id": "c5b0f32e-64c7-49cc-9b3a-371e240dc0ee",
    "name": "Syft Data & Export Lookup API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST APIs for querying Syft Data programmatically. The Lookup API returns company and contact intelligence (site sessions and LinkedIn engagement) for accounts and people Syft has already observed on your site or LinkedIn ads. The Export API retrieves the results of a motion's execution for polling integrations. The Lookup API is in alpha and available to select customers. Both APIs authenticate with a Server Secret Key that starts with `sk_live_`.\n\nContact Support:\n Name: Syft Data Support\n Email: support@syftdata.com",
      "type": "text/plain"
    }
  }
